<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            ADMOB-APP-ID — PFLICHT, SONST STÜRZT DIE APP BEIM START AB.

            Das ist kein Fehler des Plugins: Google prüft beim Initialisieren,
            ob die Angabe da ist, und beendet die App absichtlich mit einer
            deutlichen Meldung, wenn sie fehlt. Lieber ein Absturz beim
            Entwickeln als eine veröffentlichte App, die nie etwas verdient.

            ACHTUNG — NICHT DIESELBE KENNUNG wie in CONFIG.ad.admob:
              hier      APP-ID mit TILDE          ca-app-pub-…~…
              dort      ANZEIGENBLOCK mit SCHRÄGSTRICH  ca-app-pub-…/…
            Beide fangen gleich an und werden gern verwechselt.

            Eigene App-ID aus admob.google.com, eingetragen am 19.08.2026.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5384053224404265~3055250155"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
